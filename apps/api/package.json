{
  "name": "@alankar/api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "db:generate": "prisma --config ../../prisma.config.ts generate",
    "db:migrate": "prisma --config ../../prisma.config.ts migrate dev",
    "db:migrate:deploy": "prisma --config ../../prisma.config.ts migrate deploy",
    "start": "node ../../dist/apps/api/main.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.79.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0"
  }
}
