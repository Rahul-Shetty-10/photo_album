generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  uploads      Upload[]
  jobs         GenerationJob[]
  projects     Project[]
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectStep {
  EVENT
  SUBJECTS
  RELATIONSHIPS
  THEME
  TEMPLATE
  REVIEW
  GENERATE
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  name          String
  eventCategory String
  status        ProjectStatus @default(DRAFT)
  currentStep   ProjectStep   @default(EVENT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([status])
}

model Upload {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String?         @db.Uuid
  cloudinaryPublicId String
  secureUrl          String
  width              Int
  height             Int
  createdAt          DateTime        @default(now())
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brideJobs          GenerationJob[] @relation("GenerationJobBrideUpload")
  groomJobs          GenerationJob[] @relation("GenerationJobGroomUpload")

  @@index([userId])
}

model GenerationJob {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String?          @db.Uuid
  brideUploadId   String           @db.Uuid
  groomUploadId   String           @db.Uuid
  style           String
  theme           String
  aspectRatio     String
  customPrompt    String?
  prompt          String
  provider        String
  model           String
  seeds           Int[]
  numberOfImages  Int              @default(4)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  status          String
  progress        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brideUpload     Upload           @relation("GenerationJobBrideUpload", fields: [brideUploadId], references: [id], onDelete: Restrict)
  groomUpload     Upload           @relation("GenerationJobGroomUpload", fields: [groomUploadId], references: [id], onDelete: Restrict)
  generatedImages GeneratedImage[]

  @@index([userId])
  @@index([brideUploadId])
  @@index([groomUploadId])
  @@index([status])
}

model GeneratedImage {
  id        String        @id @default(uuid()) @db.Uuid
  jobId     String        @db.Uuid
  publicId  String
  secureUrl String
  seed      Int?
  width     Int?
  height    Int?
  score     Float?
  createdAt DateTime      @default(now())
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
