NODE_ENV=development
PORT=4001
API_VERSION=v1
APP_VERSION=0.0.1
LOG_LEVEL=info
CORS_ORIGIN=*

# Cloud PostgreSQL connection string. Do not use a local database for this project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis connection string for BullMQ. Use the Redis protocol URL, usually rediss://...
UPSTASH_REDIS_URL=your_aws_upstash_redis_url

POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
